MEDRAG_APP_NAME=MinerU Medical RAG
MEDRAG_ENV=local
MEDRAG_API_PREFIX=/api/v1
MEDRAG_DATABASE_URL=sqlite:///./data/sqlite/medrag.db
MEDRAG_STORAGE_DIR=./data/storage
MEDRAG_VECTOR_STORE=chroma
MEDRAG_CHROMA_PERSIST_DIR=./data/chroma
MEDRAG_EMBEDDING_BACKEND=jina
MEDRAG_EMBEDDING_MODEL=jina-embeddings-v5-text-small
MEDRAG_EMBEDDING_DIMENSION=384
MEDRAG_JINA_API_KEY=
MEDRAG_JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
MEDRAG_MOCK_MINERU_JSON=./examples/sample_mineru_output.json
MEDRAG_MINERU_API_URL=
MEDRAG_MINERU_CLI_COMMAND=mineru
MEDRAG_MINERU_LOCAL_OUTPUT_DIR=./data/mineru_outputs
MEDRAG_MINERU_CLI_TIMEOUT_SECONDS=1800
MEDRAG_MINERU_REMOTE_HOST=
MEDRAG_MINERU_REMOTE_PORT=22
MEDRAG_MINERU_REMOTE_USER=root
MEDRAG_MINERU_REMOTE_PASSWORD=
MEDRAG_MINERU_REMOTE_KEY_PATH=
MEDRAG_MINERU_REMOTE_WORK_DIR=/tmp/medrag_mineru
MEDRAG_MINERU_REMOTE_OUTPUT_DIR=./data/mineru_remote_outputs
MEDRAG_OPENAI_API_BASE=
MEDRAG_OPENAI_API_KEY=
MEDRAG_OPENAI_MODEL=
MEDRAG_LLM_PROVIDER=moonshot
MEDRAG_LLM_BASE_URL=https://api.moonshot.ai/v1
MEDRAG_LLM_MODEL=kimi-k2.5
MEDRAG_LLM_API_KEY=
